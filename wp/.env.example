# CommercialKonnect local WordPress dev — copy to wp/.env and edit if you like.
# These are LOCAL DEV DEFAULTS, not secrets. The stack is localhost-only and never public.
# Do not reuse these values anywhere real.

WORDPRESS_DB_NAME=ck_wp
WORDPRESS_DB_USER=ck_wp
WORDPRESS_DB_PASSWORD=ck_wp_dev_pw
WORDPRESS_DB_ROOT_PASSWORD=ck_wp_root_dev_pw

# Host port for the WP site (default 8090). Change if 8090 is taken on your machine.
WP_PORT=8090
