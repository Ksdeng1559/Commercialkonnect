---
import Base from "../layouts/Base.astro";
---

<Base
  title="Enquiry received | CommercialKonnect"
  description="Thanks for your enquiry. We'll review it and, with your permission, connect you with a relevant financing professional."
>
  <main class="bg-sand-50">
    <div class="mx-auto max-w-2xl px-5 py-24 text-center">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-600 text-2xl text-white">
        ✓
      </div>
      <h1 class="mt-6 text-3xl font-semibold text-ink-900">Enquiry received</h1>
      <p class="mt-4 text-base leading-8 text-ink-700">
        Thanks. We'll review what you shared and, with your permission, connect you with a relevant
        financing professional. Check your inbox for a confirmation.
      </p>
      <p class="mt-4 text-sm text-ink-700/70">
        This is not an approval or an offer of financing.
      </p>
      <a
        href="/"
        class="mt-8 inline-block rounded-full bg-brand-600 px-7 py-3 text-base font-semibold text-white transition hover:bg-brand-700"
      >
        Back to home
      </a>
    </div>
  </main>
</Base>
