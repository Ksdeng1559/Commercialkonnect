NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
BUILDDATA_API_KEY=
BUILDDATA_BASE_URL=https://api.builddata.ca
RESEND_API_KEY=
# Must be an address on the verified domain, e.g. "CommercialKonnect <noreply@mail.commercialkonnect.ca>"
EMAIL_FROM=
# Reply-To for outbound mail: a monitored mailbox where replies should land
# (e.g. an IONOS inbox like sales@commercialkonnect.ca). Optional.
EMAIL_REPLY_TO=
# Never expose service role secrets in NEXT_PUBLIC variables.

# Twilio (server-side only). Credentials: Console > Account > API keys & tokens.
# Prefer API Keys over the Auth Token for production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number in E.164 format, e.g. +16045551234
TWILIO_PHONE_NUMBER=
